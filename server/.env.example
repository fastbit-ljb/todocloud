APP_NAME=TodoCloud API
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://todocloud:change-me-in-development@localhost:5432/todocloud
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=todocloud
MINIO_SECRET_KEY=change-me-in-development
MINIO_BUCKET=attachments
MINIO_SECURE=false
AI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=
AI_MODEL=gemini-3-flash-preview
AI_FALLBACK_MODEL=gemini-3.6-flash
# Required in production: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# The server refuses to start with this placeholder when ENVIRONMENT=production.
JWT_SECRET=replace-this-before-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
LOGIN_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_MINUTE=5

# Android update check (GET /api/v1/app/version). By default the latest GitHub release of APP_RELEASE_REPO is used.
APP_RELEASE_REPO=fastbit-ljb/todocloud
# Force apps older than this to update, e.g. 1.3.0. Empty = never force.
APP_MIN_SUPPORTED_VERSION=
# Manual override if GitHub is unusable; leave empty to use GitHub.
APP_LATEST_VERSION_OVERRIDE=
APP_DOWNLOAD_URL_OVERRIDE=
APP_RELEASE_NOTES_OVERRIDE=

# Gemini thinking level (reasoning_effort). gemini-3.7/3.8-flash reject "minimal"; use "low" with them. Empty = not sent.
AI_REASONING_EFFORT=minimal
