        android:theme="@style/Theme.TodoCloud">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <!-- System share sheet: text (chat messages, links) and single images. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <!--
            Launcher entries: one activity-alias per mascot set and state, see
            branding/MascotSets.kt. Exactly one is enabled at a time. The classic set keeps the
            original unprefixed names so upgrades keep the same home-screen entry; every other
            set is disabled here and prefixed with its id. MascotSetsTest checks this list.
        -->
