<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="未来七天"
                android:textColor="@color/widget_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_date_range"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10月7日 — 10月13日"
                android:textColor="@color/widget_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_refresh_background"
            android:contentDescription="刷新任务"
            android:padding="9dp"
            android:src="@drawable/ic_widget_refresh"
            android:tint="@color/widget_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_day_container_0"
            style="@style/WidgetCalendarDay">
            <TextView android:id="@+id/widget_weekday_0" style="@style/WidgetCalendarWeekday" />
            <TextView android:id="@+id/widget_day_number_0" style="@style/WidgetCalendarDayNumber" />
            <TextView android:id="@+id/widget_day_count_0" style="@style/WidgetCalendarCount" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_day_container_1"
            style="@style/WidgetCalendarDay">
            <TextView android:id="@+id/widget_weekday_1" style="@style/WidgetCalendarWeekday" />
            <TextView android:id="@+id/widget_day_number_1" style="@style/WidgetCalendarDayNumber" />
            <TextView android:id="@+id/widget_day_count_1" style="@style/WidgetCalendarCount" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_day_container_2"
            style="@style/WidgetCalendarDay">
            <TextView android:id="@+id/widget_weekday_2" style="@style/WidgetCalendarWeekday" />
            <TextView android:id="@+id/widget_day_number_2" style="@style/WidgetCalendarDayNumber" />
            <TextView android:id="@+id/widget_day_count_2" style="@style/WidgetCalendarCount" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_day_container_3"
            style="@style/WidgetCalendarDay">
            <TextView android:id="@+id/widget_weekday_3" style="@style/WidgetCalendarWeekday" />
            <TextView android:id="@+id/widget_day_number_3" style="@style/WidgetCalendarDayNumber" />
            <TextView android:id="@+id/widget_day_count_3" style="@style/WidgetCalendarCount" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_day_container_4"
            style="@style/WidgetCalendarDay">
            <TextView android:id="@+id/widget_weekday_4" style="@style/WidgetCalendarWeekday" />
            <TextView android:id="@+id/widget_day_number_4" style="@style/WidgetCalendarDayNumber" />
            <TextView android:id="@+id/widget_day_count_4" style="@style/WidgetCalendarCount" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_day_container_5"
            style="@style/WidgetCalendarDay">
            <TextView android:id="@+id/widget_weekday_5" style="@style/WidgetCalendarWeekday" />
            <TextView android:id="@+id/widget_day_number_5" style="@style/WidgetCalendarDayNumber" />
            <TextView android:id="@+id/widget_day_count_5" style="@style/WidgetCalendarCount" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_day_container_6"
            style="@style/WidgetCalendarDay">
            <TextView android:id="@+id/widget_weekday_6" style="@style/WidgetCalendarWeekday" />
            <TextView android:id="@+id/widget_day_number_6" style="@style/WidgetCalendarDayNumber" />
            <TextView android:id="@+id/widget_day_count_6" style="@style/WidgetCalendarCount" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="3dp"
        android:text="近期任务"
        android:textColor="@color/widget_text"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout android:id="@+id/widget_task_row_0" style="@style/WidgetCalendarTaskRow">
        <TextView style="@style/WidgetCalendarTaskDot" />
        <TextView android:id="@+id/widget_task_title_0" style="@style/WidgetCalendarTaskTitle" />
        <TextView android:id="@+id/widget_task_due_0" style="@style/WidgetCalendarTaskDue" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_task_row_1" style="@style/WidgetCalendarTaskRow">
        <TextView style="@style/WidgetCalendarTaskDot" />
        <TextView android:id="@+id/widget_task_title_1" style="@style/WidgetCalendarTaskTitle" />
        <TextView android:id="@+id/widget_task_due_1" style="@style/WidgetCalendarTaskDue" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_task_row_2" style="@style/WidgetCalendarTaskRow">
        <TextView style="@style/WidgetCalendarTaskDot" />
        <TextView android:id="@+id/widget_task_title_2" style="@style/WidgetCalendarTaskTitle" />
        <TextView android:id="@+id/widget_task_due_2" style="@style/WidgetCalendarTaskDue" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_task_row_3" style="@style/WidgetCalendarTaskRow">
        <TextView style="@style/WidgetCalendarTaskDot" />
        <TextView android:id="@+id/widget_task_title_3" style="@style/WidgetCalendarTaskTitle" />
        <TextView android:id="@+id/widget_task_due_3" style="@style/WidgetCalendarTaskDue" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_task_row_4" style="@style/WidgetCalendarTaskRow">
        <TextView style="@style/WidgetCalendarTaskDot" />
        <TextView android:id="@+id/widget_task_title_4" style="@style/WidgetCalendarTaskTitle" />
        <TextView android:id="@+id/widget_task_due_4" style="@style/WidgetCalendarTaskDue" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="未来 7 天没有待办任务"
        android:textColor="@color/widget_muted"
        android:textSize="12sp" />
</LinearLayout>
